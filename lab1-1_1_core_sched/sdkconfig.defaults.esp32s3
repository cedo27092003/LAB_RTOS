# Run the command : idf.py set-target esp32s3

# =====================================================================
# Specific configuration for ESP32-S3-DevKitC-1U-N8R2
# =====================================================================

# Flash Memory Configuration (N8 = 8 MB)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM Configuration (R2 = 2 MB Quad SPI)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# Strategy: allocations >= 4KB go to PSRAM automatically
CONFIG_SPIRAM_USE_MALLOC=y

# Ensures memory alignment constraints are met for DMA
CONFIG_SPIRAM_MALLOC_ALWAYSALIGN=y

##################################################################

# disable watchdog for task
CONFIG_ESP_TASK_WDT_EN=n

# only one core to perform freertos
CONFIG_FREERTOS_UNICORE=y

# allows IDLE and TICK hook functions
CONFIG_FREERTOS_USE_IDLE_HOOK=n
CONFIG_FREERTOS_USE_TICK_HOOK=n
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# Trace facility to extract trace information
CONFIG_FREERTOS_USE_TRACE_FACILITY=n
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=n
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=n
